[Settings]
ExplorationLimit=selEntireSite
SubFoldersMode=sfmParentURLRE
PageCustomParsersAddedURLsPosition=aupBefore
PageCustomParsersAddedURLsType=autPageOnly
[TargetFiles]
File000=*.jpg
File001=*.jpeg
File002=*.png
File003=*.mp4
[ExcludedURLs]
URL000=.
[IncludedURLs]
URL000=/bundle\?path=
URL001=/files/get/
[CustomParsers]
Expression000=^(https://[^/]+)/api/v2/public/(links/[^/]+)/bundle\?path=([^&\s]+)(&password=[^&\s]+)?
Address000=/-/-/
Expression001={"name":"([^"]+)","type":"file"
Address001=[#-1:1]/content/[#-1:2]/files/get/[#1]?path=[#-1:3]%2F[#jsonencode([#1])#]
Expression002={"name":"([^"]+)","type":"dir"
Address002=[#1:1]/api/v2/public/[#1:2]/bundle?path=[#1:3]%2F[#jsonencode([#1])#][#1:4]
[CustomHTTPReferers]
URLRegExp000=/files/get/
RefererType000=hrtCustomParser
Text000=
CPRE000=^(https://[^/]+)/content(/links/[^/]+)/files/get/
CPResult000=[#1][#2]
[SubFoldersParentURLREs]
Expression000=/bundle\?path=%2F([^&]+)
Address000=[#1]
[ExcludedPageParts]
From000="file":{
To000=},"files":\[
[StartingURLTemplates]
URL000=app\.koofr\.[^/]+/links/
[TemplateSettings]
EncodedTitle=koofr%20prova

[PicFinderStart]
Expression000=^(https://app\.koofr\.[^/]+)/links/([^/?#]+)
Address000=[#1]/api/v2/public/links/[#2]/bundle?path=%2F
PasswordParam000=password
